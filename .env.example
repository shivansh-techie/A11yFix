# Optional — enables AI-generated fixes for rules not in the built-in dictionary.
# Get a key at https://console.anthropic.com
# Without this key the app still works fully using the pre-written fix library.
ANTHROPIC_API_KEY=

# SQLite DB location (default: data/a11yfix.db — no need to change for local use)
DB_PATH=data/a11yfix.db

# Ports (Railway/Render override PORT automatically)
API_PORT=8000
PORT=8501
